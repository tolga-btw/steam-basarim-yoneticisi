<Window x:Class="SteamAchievementManager.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Steam Achievement Manager" Icon="pack://application:,,,/SteamAchievementManager;component/Assets/app.ico"
        Width="1080" Height="720" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="28,22,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/SteamAchievementManager;component/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Steam Achievement Manager" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" Width="230" TextChanged="SearchBox_TextChanged"/>
                <TextBox x:Name="AppIdBox" Style="{StaticResource Field}" Width="128" Margin="10,0,0,0" KeyDown="AppIdBox_KeyDown"/>
                <Button x:Name="OpenButton" Margin="6,0,0,0" Click="OpenButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="10,0,0,0" Click="RefreshButton_Click"/>
                <Border Style="{StaticResource SegmentHost}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangTr" Style="{StaticResource Segment}" GroupName="Lang" Content="TR" Padding="10,5" Checked="Lang_Checked"/>
                        <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="Lang" Content="EN" Padding="10,5" Checked="Lang_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="GamesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="28,0,12,12">
            <ItemsControl x:Name="GamesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Width="232" Margin="0,0,16,16" Click="Game_Click" ToolTip="{Binding Name}">
                            <StackPanel>
                                <Grid Height="108">
                                    <Border CornerRadius="9,9,0,0" Background="{StaticResource Surface2Brush}">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                                    </Border>
                                    <Border CornerRadius="9,9,0,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,10,12,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AppIdText}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="12,2,12,11"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock x:Name="MessageText" Foreground="{StaticResource TextDimBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="RetryButton" Margin="0,16,0,0" HorizontalAlignment="Center" Click="RefreshButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
