<Window x:Class="SteamAchievementManager.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Steam Achievement Manager" Icon="pack://application:,,,/SteamAchievementManager;component/Assets/app.ico"
        Width="980" Height="740" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="AchievementTemplate">
            <Border CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="6" Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
                        <Border CornerRadius="6" Opacity="{Binding IconOpacity}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8,1,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Background="Transparent"
                                       ToolTip="{Binding ProtectedTip}" Visibility="{Binding Protected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{StaticResource TextFaintBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,4,0"
                              IsChecked="{Binding IsAchieved, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StatTemplate">
            <Border CornerRadius="10" Padding="16,10,12,10" Margin="0,0,0,8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0"
                                   Visibility="{Binding ShowId, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                               VerticalAlignment="Center" Margin="12,0,14,0"/>
                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Padding="10,5" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding ReadOnly}" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Game header -->
        <Grid Margin="28,24,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Width="196" Height="92" CornerRadius="8" Background="{StaticResource Surface2Brush}">
                <Border CornerRadius="8">
                    <Border.Background>
                        <ImageBrush x:Name="HeaderImage" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="GameName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,10"/>
                <Grid Height="6" Width="440" HorizontalAlignment="Left">
                    <Border CornerRadius="3" Background="{StaticResource Surface2Brush}"/>
                    <Border CornerRadius="3" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Tabs, filters, search, bulk actions -->
        <Grid Grid.Row="1" Margin="28,0,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabAchievements" Style="{StaticResource Segment}" GroupName="Tab" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabStats" Style="{StaticResource Segment}" GroupName="Tab" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>
            <Border x:Name="FilterPanel" Grid.Column="1" Style="{StaticResource SegmentHost}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="Filter" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterUnlocked" Style="{StaticResource Segment}" GroupName="Filter" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FilterLocked" Style="{StaticResource Segment}" GroupName="Filter" Checked="Filter_Checked"/>
                </StackPanel>
            </Border>
            <TextBox x:Name="SearchBox" Grid.Column="3" Style="{StaticResource SearchField}" Width="230" TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="BulkPanel" Orientation="Horizontal" Margin="14,0,28,10">
                <Button x:Name="UnlockAllButton" Style="{StaticResource QuietButton}" Click="UnlockAll_Click"/>
                <Button x:Name="LockAllButton" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Click="LockAll_Click"/>
                <Button x:Name="InvertButton" Style="{StaticResource QuietButton}" Margin="4,0,0,0" Click="Invert_Click"/>
            </StackPanel>
            <ListBox x:Name="AchievementList" Grid.Row="1" Style="{StaticResource PlainList}" Padding="28,0,28,12"
                     ItemTemplate="{StaticResource AchievementTemplate}"/>
            <ListBox x:Name="StatList" Grid.Row="1" Style="{StaticResource PlainList}" Padding="28,0,28,12"
                     ItemTemplate="{StaticResource StatTemplate}" Visibility="Collapsed"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{StaticResource TextDimBrush}" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="0,0,0,40"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ResetButton" Style="{StaticResource DangerButton}" Click="Reset_Click"/>
                    <Button x:Name="RefreshButton" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
